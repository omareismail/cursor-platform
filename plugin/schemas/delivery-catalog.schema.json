{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cursor-platform/schemas/delivery-catalog.schema.json",
  "title": "Delivery phase catalog (preview/apply)",
  "//": "A catalog describes structure: ids, names, objectives, dependencies and checkpoint types. It must not carry completion, evidence, reviewers or history. project.mjs delivery catalog apply refuses those fields.",
  "type": "object",
  "required": ["schemaVersion", "phases"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^PHASE-\\d+$" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "order": { "type": "number" },
          "owner": { "type": ["string", "null"] },
          "objectives": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "required": { "type": "boolean" }
              }
            }
          },
          "entryCriteria": { "type": "array" },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "checkpointTypes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
