# Local Cursor settings (MCP tokens via env vars — never commit)
.cursor/settings.local.json
.cursor/settings.local.json.bak-*

# Local Claude Code overrides.
# NOTE: .claude/settings.json IS committed — it holds the hook wiring the whole
# team depends on. Personal tweaks belong in .claude/settings.local.json.
.claude/settings.local.json

# Machine-generated cache (regenerated by /repo-discovery)
.cursor/cache/*
!.cursor/cache/.gitkeep

# NOTE: plugin/ is a GENERATED but COMMITTED artifact. A marketplace with a
# local ./plugin source has to be able to fetch it, so it is deliberately not
# ignored. Rebuild with: node .cursor/tools/build-plugin.mjs build

# NOTE: lifecycle/releases/ and lifecycle/evidence/ are COMMITTED. They are the
# audit trail — which gates were standing when a version shipped, and who signed
# it. The hash inside each record catches an accidental edit; git history is what
# makes it evidence. Ignoring them would delete the point of writing them.

# Archives / local backups
*.rar
*.zip

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Node (hook scripts have no dependencies, but templates/ may be tried in place)
node_modules/
.eslintcache

# .NET
bin/
obj/
[Tt]est[Rr]esults/
coverage/
*.user

# build-plugin.mjs writes plugin.__check__/ while verifying the tree is in sync
# and removes it on the way out. An interrupted run leaves it behind; it is a
# temp artifact, never a deliverable.
plugin.__check__/
